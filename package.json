{
  "name": "todo-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "list": "node index.js list",
    "stats": "node index.js stats",
    "test": "node apps/terminal/test/smoke.test.mjs",
    "test:api": "node apps/backend/test/api.test.mjs",
    "test:ssh": "node apps/backend/test/ssh.test.mjs",
    "server": "npm run dev --workspace @todo/backend",
    "server:all": "npm run dev --workspace @todo/backend",
    "ssh": "node apps/backend/server/ssh-server.js",
    "build:web": "cp apps/frontend/public/index.html apps/frontend/public/style.css apps/frontend/public/app.js apps/frontend/dist/",
    "dev:backend": "node apps/backend/server/all.js",
    "dev:terminal": "node apps/terminal/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "todo",
    "cli",
    "task-manager",
    "terminal"
  ],
  "author": "",
  "license": "ISC",
  "description": "A task manager with web, SSH and CLI surfaces over one shared store",
  "dependencies": {
    "chalk": "^6.0.0",
    "express": "^5.2.1",
    "inquirer": "^12.4.2",
    "ssh2": "^1.17.0"
  }
}
