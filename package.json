{
  "name": "todo-cli",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "bin": {
    "todo": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "list": "node index.js list",
    "stats": "node index.js stats",
    "test": "node test/smoke.test.mjs",
    "server": "node server/start.js",
    "api": "node server/start.js",
    "test:api": "node test/api.test.mjs",
    "ssh": "node server/ssh-server.js",
    "test:ssh": "node test/ssh.test.mjs",
    "build:web": "cp web/public/index.html web/public/style.css web/public/app.js web/dist/",
    "server:all": "node server/all.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "todo",
    "cli",
    "task-manager",
    "terminal"
  ],
  "author": "",
  "license": "ISC",
  "description": "A terminal task manager with colored tables, priorities and done tracking",
  "dependencies": {
    "chalk": "^6.0.0",
    "express": "^5.2.1",
    "inquirer": "^12.4.2",
    "ssh2": "^1.17.0"
  }
}
